# Copy to .env (never commit .env). Set these in Hostinger > Deploy > Environment variables.
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DBNAME
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=https://your-domain.example
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
OPENAI_API_KEY=
CRON_SECRET=generate-a-long-random-string
SELLER_NAME=Nexpreneur
SELLER_GSTIN=
OPENAI_MODEL=gpt-4o-mini
SMTP_FROM=Nexpreneur OS <you@your-domain.com>

# --- Optional integrations (each feature turns on when its values are set) ---
# WhatsApp Business Cloud API: needs an approved message template with 2 text variables (title, details). Default name nx_notification.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=nx_notification
WHATSAPP_LANG=en
# SMS through MSG91 (DLT-approved flow template with variables var1 and var2)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Web push: generate with  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.com
# e-Invoicing (IRN): your GSP / gateway that accepts the NIC e-invoice JSON. See README.
EINV_API_URL=
EINV_API_TOKEN=
# Single sign-on (OpenID Connect): Microsoft Entra ID, Google Workspace, Okta, Keycloak...
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAINS=
OIDC_NAME=Single sign-on
